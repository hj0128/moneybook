<?xml version="1.0" encoding="utf-8"?>
<!--
    기기 자동 백업과 기기 간 이전(Android 12 이상). backup_rules.xml 과 같은 것을 담는다.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
